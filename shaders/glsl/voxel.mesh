#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_debug_printf : enable
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

// Mesh shader for GPU-driven voxel rendering
// Fetches 64-bit vertex data from per-chunk buffers and emits primitives
// Replaces traditional vertex shader in task/mesh pipeline

// Mesh shader output limits (adjust based on hardware)
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 256, max_primitives = 85) out; // 85 triangles * 3 = 255 vertices

// ===== BUFFER DEVICE ADDRESS =====
layout(buffer_reference, std430, buffer_reference_align = 8) readonly buffer VertexBuffer {
    uint64_t vertices[];
};

// ===== INPUT: CAMERA DATA (UBO) =====
struct GPUCameraData {
    mat4 viewProjection;
    vec4 planes[6];
    vec3 cameraPos;
    float maxRenderDistance;
};

layout(set = 0, binding = 0, std140) uniform CameraUniform {
    GPUCameraData camera;
};

// ===== INPUT: CHUNK DATA (SSBO) =====
struct GPUChunkData {
    vec3 chunkWorldPos;
    uint indexCount;
    uint64_t vertexBufferAddress;
    uint firstIndex;
    uint _padding;
};

layout(set = 0, binding = 1, std430) readonly buffer ChunkDataBuffer {
    GPUChunkData chunks[];
};

// ===== INPUT: SHARED INDEX BUFFER =====
// Mega index buffer shared by all chunks
layout(set = 0, binding = 2, std430) readonly buffer IndexBuffer {
    uint indices[];
};

// ===== TASK SHADER PAYLOAD =====
struct TaskPayloadEntry {
    uint chunkIndex;
    uint tileIndex;
};

struct TaskPayloadData {
    uint meshCount;
    TaskPayloadEntry entries[2047]; // Must match task shader payload size
};

taskPayloadSharedEXT TaskPayloadData payload;

// ===== PUSH CONSTANTS =====
layout(push_constant) uniform PushConstants {
    uint totalChunks;
    float chunkSize;
    uint maxVerticesPerMeshWorkgroup;
    uint maxMeshWorkgroupsPerTask;
}
push;

// ===== OUTPUT TO FRAGMENT SHADER =====
layout(location = 0) out vec3 outNormal[];
layout(location = 1) out vec4 outColor[];
layout(location = 2) out vec2 outUV[];
layout(location = 3) flat out uint outTextureId[];
layout(location = 4) flat out uint outDummy[]; // Dummy to maintain contiguous locations
layout(location = 5) flat out uint outNormalId[];
layout(location = 6) out float outAO[];

// ===== VERTEX UNPACKING (same as voxel.vert) =====
const vec3 NORMALS[6] = vec3[](vec3(1.0, 0.0, 0.0),  // 0: East
                               vec3(-1.0, 0.0, 0.0), // 1: West
                               vec3(0.0, 1.0, 0.0),  // 2: Top
                               vec3(0.0, -1.0, 0.0), // 3: Bottom
                               vec3(0.0, 0.0, 1.0),  // 4: North
                               vec3(0.0, 0.0, -1.0)  // 5: South
);

// Base UVs for quad corners (will be scaled by greedy dimensions)
const vec2 UVS[4] = vec2[](vec2(0.0, 0.0), // 0: Bottom-left
                           vec2(1.0, 0.0), // 1: Bottom-right
                           vec2(1.0, 1.0), // 2: Top-right
                           vec2(0.0, 1.0)  // 3: Top-left
);

// ===== MAIN MESH SHADER =====
void main() {
    uint localID = gl_LocalInvocationID.x;

    // gl_WorkGroupID.x is LOCAL to this task workgroup (0 to N-1)
    // Each task workgroup has its own taskPayloadSharedEXT that only its mesh shaders see
    uint payloadIdx = gl_WorkGroupID.x;

    if (payloadIdx >= payload.meshCount) {
        SetMeshOutputsEXT(0, 0);
        return;
    }

    TaskPayloadEntry task = payload.entries[payloadIdx];

    GPUChunkData chunk = chunks[task.chunkIndex];

    // SAFETY CHECK: Prevent GPU crash on iGPUs when chunk is unloaded
    if (chunk.vertexBufferAddress == 0) {
        if (localID == 0) {
            debugPrintfEXT("[MESH WG=%u] WARNING: chunk %u has null vertex buffer address, dropping tile=%u\n",
                           gl_WorkGroupID.x, task.chunkIndex, task.tileIndex);
        }
        SetMeshOutputsEXT(0, 0);
        return;
    }

    // Convert device address to buffer reference
    VertexBuffer vertexBuffer = VertexBuffer(chunk.vertexBufferAddress);

    // ===== CALCULATE TILE RANGE =====
    // Each mesh workgroup processes a tile of the chunk's geometry
    // Mesh shader can output max 85 primitives (255 vertices), so each tile handles at most 85
    // triangles
    const uint maxTrianglesPerTile = 85;

    uint totalTriangles = chunk.indexCount / 3;
    uint tileStart =
        task.tileIndex * maxTrianglesPerTile * 3; // Start index (in indices, not triangles)
    uint tileEnd = min(tileStart + maxTrianglesPerTile * 3, chunk.indexCount); // End index
    uint tileIndexCount = tileEnd - tileStart;

    // Calculate how many triangles this tile actually has
    uint tilePrimitiveCount = tileIndexCount / 3;

    // Clamp to mesh shader limits
    uint actualPrimitives = min(tilePrimitiveCount, 85);
    uint actualVertices = actualPrimitives * 3; // 3 vertices per triangle

    if (actualVertices == 0) {
        if (localID == 0) {
            debugPrintfEXT("[MESH WG=%u] WARNING: zero-sized tile for chunk=%u tile=%u indexCount=%u tileStart=%u tileEnd=%u\n",
                           gl_WorkGroupID.x, task.chunkIndex, task.tileIndex, chunk.indexCount,
                           tileStart, tileEnd);
        }
        SetMeshOutputsEXT(0, 0);
        return;
    }

    // Set mesh output counts (must be done by all threads, or just first thread)
    SetMeshOutputsEXT(actualVertices, actualPrimitives);

    // ===== PROCESS VERTICES IN PARALLEL =====
    // Each thread processes multiple vertices (strided access)
    // We output vertices sequentially in the order they appear in the index buffer for this tile
    for (uint i = localID; i < actualVertices; i += 32) {

        // Fetch index from mega index buffer for this tile
        uint globalIndex = chunk.firstIndex + tileStart + i;
        uint vertexIndex = indices[globalIndex];

        uint64_t inVertexData = vertexBuffer.vertices[vertexIndex];

        // Split into two 32-bit words
        uint word0 = uint(inVertexData & 0xFFFFFFFFul);
        uint word1 = uint(inVertexData >> 32);

        // Unpack word0: [X:6][Y:6][Z:6][Normal:3][UV:2][Texture:7][AO:2]
        uint x = (word0) & 0x3Fu;
        uint y = (word0 >> 6) & 0x3Fu;
        uint z = (word0 >> 12) & 0x3Fu;
        uint normalId = (word0 >> 18) & 0x7u;
        uint uvId = (word0 >> 21) & 0x3u;
        uint textureId = (word0 >> 23) & 0x7Fu;
        uint ao = (word0 >> 30) & 0x3u;

        // Unpack word1: [Width:5][Height:5][Reserved:22]
        uint greedyWidth = (word1 & 0x1Fu) + 1; // 0-31 maps to 1-32
        uint greedyHeight = ((word1 >> 5) & 0x1Fu) + 1;

        vec3 inPosition = vec3(float(x), float(y), float(z));
        vec3 normal = NORMALS[normalId];

        // Scale UVs by greedy quad dimensions for texture tiling
        vec2 baseUV = UVS[uvId];
        vec2 uv = baseUV * vec2(float(greedyWidth), float(greedyHeight));

        // Convert AO to brightness multiplier
        float aoValue = 1.0 - (float(ao) * 0.25);

        // Transform to world space and project
        vec3 worldPos = inPosition + chunk.chunkWorldPos;

        // Output vertex at position i (sequential output matching our primitive indices)
        gl_MeshVerticesEXT[i].gl_Position = camera.viewProjection * vec4(worldPos, 1.0);

        // Output vertex attributes
        outNormal[i] = normal;
        outColor[i] = vec4(abs(normal), 1.0);
        outUV[i] = uv;
        outTextureId[i] = textureId;
        outDummy[i] = 0u; // Dummy value
        outNormalId[i] = normalId;
        outAO[i] = aoValue;
    }

    // ===== BUILD PRIMITIVE INDICES =====
    // Build triangles using sequential vertex indices (0,1,2), (3,4,5), etc.
    // This matches the order we output vertices above
    for (uint i = localID; i < actualPrimitives; i += 32) {
        uint baseVertex = i * 3;
        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(baseVertex, baseVertex + 1, baseVertex + 2);
    }
}
